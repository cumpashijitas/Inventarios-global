# =====================================================================
# Backend env vars — copia este archivo a .env y rellena los valores.
# .env NO se commitea (ver .gitignore).
# =====================================================================

# --- App ---
APP_ENV=development              # development | staging | production
APP_NAME="Inventario SaaS API"
APP_VERSION=0.1.0
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# CORS — en prod restringir al dominio del frontend
# En dev: URL del frontend local (ej: Vite 5173)
# En prod: dominio real del frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---
# Project Settings → API

# Copiar desde: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Copiar desde: Supabase Dashboard → Project Settings → API → anon public key
SUPABASE_ANON_KEY=

# Copiar desde: Supabase Dashboard → Project Settings → API → service_role key
# ¡SECRETO! Solo backend, jamás al frontend
SUPABASE_SERVICE_ROLE_KEY=

# Copiar desde: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# JWT — NUESTRO secret (independiente de Supabase). Generar con:
#   openssl rand -base64 64
# o desde Python: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=inventario-saas
JWT_EXPIRES_MINUTES=1440         # 24 horas

# --- Database (Postgres directo vía asyncpg) ---
# Project Settings → Database → Connection string (URI)
# Copiar desde: Supabase Dashboard → Project Settings → Database → Connection string
# Reemplazar user/password/host/db según tu proyecto
# Importante: usar el "Session pooler" (puerto 5432) para conexiones largas/transacciones,
# o el "Transaction pooler" (puerto 6543) si solo haces queries cortas tipo serverless.
DATABASE_URL=postgresql://user:password@host:5432/db_name
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# --- Sentry (opcional en dev) ---
# Crear proyecto en https://sentry.io y copiar el DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Seguridad ---
# Lista de IPs admin (para super-admin endpoints, vacía = bloquear todos)
# Separar múltiples IPs con coma (ej: 127.0.0.1,192.168.1.10)
ADMIN_IP_ALLOWLIST=